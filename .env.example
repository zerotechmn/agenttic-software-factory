# Copy to .env (git-ignored) and fill in. `./forge` loads it on every command; an exported shell variable wins.

# Required: every agent is a Claude call billed to this key (no local model needed).
ANTHROPIC_API_KEY=

# Optional
# CONTEXT7_API_KEY=            higher rate limits for the researcher's docs lookup
# FORGE_SCRAPLING_MCP=         path to scrapling-mcp (Python); without it the researcher uses WebFetch
